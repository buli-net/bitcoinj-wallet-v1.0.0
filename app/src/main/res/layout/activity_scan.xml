<?xml version="1.0" encoding="utf-8"?>

<!-- Release layout resource for activity_scan. Presentation copy is referenced from Android string resources so the English release text has a single source of truth. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">
    <android.support.v7.widget.Toolbar
        android:id="@+id/toolbar_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:theme="@style/WalletToolbarTheme"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/scan_opening"
        android:textSize="18sp"/>
</LinearLayout>
