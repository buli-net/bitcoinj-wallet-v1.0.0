<?xml version="1.0" encoding="utf-8"?>

<!-- Release layout resource for activity_send. Presentation copy is referenced from Android string resources so the English release text has a single source of truth. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">
    <android.support.v7.widget.Toolbar
        android:id="@+id/toolbar_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:theme="@style/WalletToolbarTheme"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp">
                <ImageView
                    android:id="@+id/ivMyQr_send"
                    android:layout_width="150dp"
                    android:layout_height="150dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_address_to_sender"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingTop="4dp"/>
                <TextView
                    android:id="@+id/tvWalletPath_send"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"/>
                <TextView
                    android:id="@+id/tvMyAddress_send"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:maxLines="2"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/to_label"
                        android:textSize="15sp"/>
                    <EditText
                        android:id="@+id/etRecipient_send"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:hint="@string/recipient_hint"
                        android:inputType="textNoSuggestions"
                        android:textSize="13sp"
                        android:maxLines="2"/>
                    <Button
                        android:id="@+id/btnScan_send"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/qr"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/amount_label"
                        android:textSize="15sp"/>
                    <EditText
                        android:id="@+id/etAmount_send"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:hint="@string/amount_hint"
                        android:inputType="numberDecimal"
                        android:textSize="15sp"/>
                    <Button
                        android:id="@+id/btnMax_send"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/max"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btc_suffix"
                        android:textSize="14sp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvFeeRate_send"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/fee_rate_initial"
                    android:textSize="15sp"/>
                <SeekBar
                    android:id="@+id/seekFee_send"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fee_rate_min"
                        android:textSize="12sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fee_rate_max"
                        android:textSize="12sp"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvEstimatedFee_send"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/estimated_fee_title"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <Button
                android:id="@+id/btnSend_send"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/send_button"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
