<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="wallet.main">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <service
            android:name="wallet.main.BitcoinSyncService"
            android:enabled="true"
            android:exported="false" />

        <activity android:name="wallet.main.SyncActivity" android:screenOrientation="portrait" />
        <activity android:name="wallet.send.SendActivity" android:screenOrientation="portrait" />
        <activity android:name="wallet.backup.BackupActivity" android:screenOrientation="portrait" />
        <activity android:name="wallet.backup.RestoreActivity" android:screenOrientation="portrait" />
        <activity android:name="wallet.security.SecurityActivity" android:screenOrientation="portrait" />
        <activity android:name="wallet.tools.WalletToolsActivity" android:screenOrientation="portrait" />
        <activity android:name="wallet.tools.CoinControlActivity" android:screenOrientation="portrait" />
        <activity android:name="wallet.about.AboutActivity" android:screenOrientation="portrait" />

        <activity
            android:name="wallet.main.MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
